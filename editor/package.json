{
  "name": "dbx-markdown-editor",
  "version": "2.0.0",
  "description": "DBX 工作台内的所见即所得 Markdown 编辑器：基于 iml-editor-lite（MIT）。",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "dev:web": "vite --port 5173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/check-provenance.mjs && tsc --noEmit -p tsconfig.json && vite build && node scripts/finalize.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && node scripts/check-provenance.mjs",
    "check:provenance": "node scripts/check-provenance.mjs"
  },
  "keywords": [
    "markdown",
    "editor",
    "dbx",
    "tiptap"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-bubble-menu": "^2.11.5",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-floating-menu": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-text-align": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/suggestion": "^2.27.2",
    "@types/katex": "^0.16.8",
    "@types/marked": "^5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@uiw/react-codemirror": "^4.25.8",
    "@vitejs/plugin-react": "^5.1.4",
    "docx": "^9.7.1",
    "dompurify": "^3.4.15",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "katex": "^0.16.38",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.577.0",
    "marked": "^15.0.0",
    "mermaid": "^11.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.0",
    "zustand": "^5.0.11"
  }
}
